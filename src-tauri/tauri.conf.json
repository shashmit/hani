{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "hani",
  "version": "1.1.0",
  "identifier": "com.drai.hani",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8082",
    "beforeDevCommand": "npx expo start --port 8082",
    "beforeBuildCommand": "npx expo export -p web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hani",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 26 },
        "backgroundColor": "#2A1D14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Finance",
    "shortDescription": "Your money & tasks, in blocks",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
